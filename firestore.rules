
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isNotBlacklisted() {
        // This function remains potentially problematic if the user doc doesn't exist.
        // It's safer to check for existence first where this is called.
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               getUserData().blacklisted == false;
    }

    function isAdmin() {
        // This is the key fix. It checks for the existence of the user document
        // and then safely checks the roles array. This avoids recursion.
        return isSignedIn() &&
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               'roles' in getUserData() &&
               getUserData().roles.hasAny(['Администратор', 'admin']);
    }

    function isManager() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             'roles' in getUserData() &&
             getUserData().roles.hasAny(['admin', 'Администратор', 'Менеджер']);
    }

    function isVerifiedOwner(userId) {
      // Allow reading own document even if it's not fully created yet.
      return request.auth != null && request.auth.uid == userId;
    }
    
    function hasAccessToBranch(branchId) {
      return isSignedIn() &&
             isNotBlacklisted() &&
             (isAdmin() || 
                (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 'branchIds' in getUserData() &&
                 branchId in getUserData().branchIds)
             );
    }

    match /users/{userId} {
      // Allow any authenticated user to read their OWN document.
      // This is crucial to break the recursive loop.
      allow get: if isVerifiedOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      // An update should only be done by the owner or an admin
      allow update: if (isOwner(userId) && isNotBlacklisted()) || isAdmin();
      allow delete: if (isOwner(userId) && isNotBlacklisted()) || isAdmin();
    }

    match /users/{userId}/reportSettings/{reportSettingId} {
      allow get, list: if isOwner(userId) && isNotBlacklisted();
      allow create: if isOwner(userId) && isNotBlacklisted() && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && isNotBlacklisted() && resource != null && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) && isNotBlacklisted() && resource != null;
    }

    match /branches/{branchId} {
      allow get: if hasAccessToBranch(branchId);
      allow list: if isAdmin() || (isNotBlacklisted() && request.query.keys.hasOnly(['__name__']));
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    match /lots/{lotId} {
      allow read, list: if isSignedIn() && isNotBlacklisted();
      allow create: if isManager() && hasAccessToBranch(request.resource.data.branchId);
      allow update: if isManager() && hasAccessToBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isSignedIn() && isNotBlacklisted() && (hasAccessToBranch(resource.data.branchId) || isOwner(resource.data.userId));
      allow list: if isSignedIn() && isNotBlacklisted();
      allow create: if isOwner(userId) && isNotBlacklisted();
      allow update: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read, list: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(resource.data.branchId);
      allow create, update: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }
    
    match /allocations/{allocationId} {
      allow read, list: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(resource.data.branchId);
      allow create, update: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /branches/{branchId}/procurementProcesses/{procurementProcessId} {
      allow get, list: if hasAccessToBranch(branchId);
      allow create: if hasAccessToBranch(branchId) && isManager();
      allow update: if hasAccessToBranch(branchId) && isManager() && resource != null;
      allow delete: if hasAccessToBranch(branchId) && isAdmin() && resource != null;
    }
  }
}
