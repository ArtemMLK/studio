
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isNotBlacklisted() {
      return !('blacklisted' in getUserData()) || getUserData().blacklisted == false;
    }

    function isAdmin() {
      return isSignedIn() && 'roles' in getUserData() && getUserData().roles.hasAny(['admin', 'Администратор']);
    }

    function isManager() {
      return isSignedIn() && 'roles' in getUserData() && getUserData().roles.hasAny(['admin', 'Администратор', 'Менеджер']);
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && isNotBlacklisted();
    }
    
    function hasAccessToBranch(branchId) {
      return isSignedIn() && isNotBlacklisted() && (isAdmin() || branchId in getUserData().branchIds);
    }
    
    // NEW: Function to check if a user can list branches they are part of.
    function canListOwnBranches() {
      return isSignedIn() && isNotBlacklisted();
    }

    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if (isVerifiedOwner(userId) || isAdmin()) && resource != null;
      allow delete: if (isVerifiedOwner(userId) || isAdmin()) && resource != null;
    }

    match /users/{userId}/reportSettings/{reportSettingId} {
      allow get, list: if isVerifiedOwner(userId);
      allow create: if isVerifiedOwner(userId) && request.resource.data.userId == userId;
      allow update: if isVerifiedOwner(userId) && resource != null && request.resource.data.userId == resource.data.userId;
      allow delete: if isVerifiedOwner(userId) && resource != null;
    }

    match /branches/{branchId} {
      // Allow reading a specific branch if user has access.
      allow get: if hasAccessToBranch(branchId);
      // Allow listing branches if user is admin OR if they are querying for their own branches.
      allow list: if isAdmin() || (canListOwnBranches() && request.query.keys.hasOnly(['__name__']));
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }

    match /lots/{lotId} {
      allow read: if isSignedIn() && isNotBlacklisted();
      // NEW: Allow listing lots, as this is needed for participants and others.
      // Client-side query will apply filters, but the basic list must be allowed.
      allow list: if isSignedIn() && isNotBlacklisted();
      allow create: if isManager() && hasAccessToBranch(request.resource.data.branchId);
      allow update: if isManager() && hasAccessToBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isSignedIn() && isNotBlacklisted() && (hasAccessToBranch(resource.data.branchId) || isOwner(resource.data.userId));
      allow list: if isSignedIn() && isNotBlacklisted(); // Query will be filtered on client
      allow create: if isVerifiedOwner(request.resource.data.userId);
      allow update: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /receipts/{receiptId} {
      allow read, list: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(resource.data.branchId);
      allow create, update: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }
    
    match /allocations/{allocationId} {
      allow read, list: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(resource.data.branchId);
      allow create, update: if isSignedIn() && isNotBlacklisted() && hasAccessToBranch(request.resource.data.branchId);
      allow delete: if isAdmin();
    }

    match /branches/{branchId}/procurementProcesses/{procurementProcessId} {
      allow get: if hasAccessToBranch(branchId);
      // List is allowed if the user has access to the parent branch.
      // This is secure for subcollection queries filtered by branchId.
      allow list: if hasAccessToBranch(branchId);
      allow create: if hasAccessToBranch(branchId) && isManager();
      allow update: if hasAccessToBranch(branchId) && isManager() && resource != null;
      allow delete: if hasAccessToBranch(branchId) && isAdmin() && resource != null;
    }
  }
}
